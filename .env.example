# ========================================
# Nano Banana Pro - 环境变量配置模板
# 复制此文件为 .env 并填写相应配置
# ========================================

# ========== 必填配置 ==========

# Flask 会话密钥
# 请使用随机字符串，可通过以下命令生成：
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_random_secret_key_here

# 管理员密码
# 首次启动时会创建 admin 账号
ADMIN_PASSWORD=your_admin_password_here

# 后台保存 API/SMTP 凭据时使用的独立 Fernet 加密密钥
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 部分面板会去掉密钥末尾的“=”填充；应用兼容这种无填充形式
CREDENTIAL_ENCRYPTION_KEY=your_fernet_key_here


# ========== 可选配置 ==========

# Gemini API 密钥（推荐在管理员后台界面配置，此为 Fallback 选项）
# 从 https://aistudio.google.com/apikey 获取
# GEMINI_API_KEY=your_gemini_api_key_here


# 运行环境 (development/production)
# 生产环境会启用 HTTPS 强制、安全响应头等
FLASK_ENV=development

# 调试模式 (True/False)
# 生产环境请设为 False
FLASK_DEBUG=False

# 自定义 API 端点（如使用代理服务）
# 留空则使用 Google 官方 API
# GEMINI_API_BASE_URL=http://127.0.0.1:8045

# 默认模型（必须是应用支持的模型 ID）
# DEFAULT_MODEL=gemini-3.1-flash-image


# ========== 邮件验证码 ==========

# 也可在管理员后台配置；环境变量作为逐字段 fallback
# EMAIL_SENDER=your_email@example.com
# EMAIL_PASSWORD=your_email_password_or_app_password
# SMTP_SERVER=smtp.example.com
# SMTP_PORT=465
# SMTP_TIMEOUT=15


# ========== 生产部署与存储 ==========

# 仅在应用位于可信反向代理之后时设置；单层 Nginx 通常为 1
# TRUST_PROXY_COUNT=1

# 多 worker 必须使用共享限流存储，例如 Redis
# RATELIMIT_STORAGE_URI=redis://127.0.0.1:6379/0

# DATABASE_FILE=data/users.db
# DATA_DIR=data
# IMAGES_DIR=static/images
# THUMBNAILS_DIR=static/thumbnails
# DATABASE_BUSY_TIMEOUT_MS=5000


# ========== 请求与后台任务限制 ==========

# MAX_REQUEST_BYTES=52428800
# MAX_REFERENCE_IMAGE_BYTES=10485760
# MAX_REFERENCE_TOTAL_BYTES=36700160
# MAX_REFERENCE_PIXELS=40000000

# 生成扣费预留的恢复窗口，最低 600 秒，默认 900 秒
# GENERATION_CHARGE_TTL_SECONDS=900
# GENERATION_LOCK_TIMEOUT=330

# 测试或外部任务调度场景可关闭应用内后台线程
# DISABLE_BACKGROUND_TASKS=false
# CHAT_IDLE_TIMEOUT=1800
# CHAT_CLEANUP_INTERVAL=600
